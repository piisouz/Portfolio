#include <iostream>
#include <vector>
#include <string>
using namespace std;

vector<string> inventory = {"Barrel x 3", "Paper x 64"};
vector<string> employees = {"Paul", "Steve"};
vector<string> orders = {};
vector<string> employeeOrders = {};

// managers


void Inventory(){
   
   
    cout << "The current Inventory is: " << endl;
    for(const auto& Inv : inventory) {
        cout << Inv << endl;
    }
   
    int option = 0;
    string addItem;
    int index;
   
   
    while(option != 4){
       
        cout << "Press 1: To Add items to the inventory " << endl;
        cout << "Press 2: To Edit items to the inventory " << endl;
        cout << "Press 3: To Remove items to the inventory " << endl;
        cout << "Press 4: To continue" << endl;
        cin >> option;
        cin.ignore();
       
        if(option == 1){
            cout << "Enter a item to add";
            getline(cin, addItem);
            inventory.push_back(addItem);
        }
        else if(option == 2){
            cout << "What index would you like to change? " << endl;
            cin >> index;
            cin.ignore();
            cout << "Enter the New item" << endl;
            getline(cin, addItem);
            inventory[index] = addItem;
        }
        else if(option == 3){
            cout << "What index would you like to remove? " << endl;
            cin >> index;
            cin.ignore();
           
            inventory.erase(inventory.begin() + index);
        }
        else if(option == 4){
            cout << "Okay!" << endl;
        }
        else{
            cout << "Invalid Choice";
           
        }
       
       
    }
    cout << "The current Inventory is: " << endl;
    for(const auto& Inventory : inventory) {
        cout << Inventory << endl;
    }
   
   
}

