<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #1e1e1e;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.systemsoftproject.controllers.Controller">
    <top>
        <HBox spacing="10" style="-fx-background-color: #2c3e50;" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
            <Label text="NETWORK MANAGEMENT CONSOLE" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            
            <Button fx:id="btnSync" text="Sync DB" onAction="#handleSync" />
            
            <Button text="Change Password" onAction="#handleChangePassword" />
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #8b0000; -fx-text-fill: white;" />
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.4" style="-fx-background-color: transparent;">
            <items>
                <TabPane tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                        <Tab text="Files">
                            <VBox spacing="10" style="-fx-padding: 10;">
                                <ListView fx:id="fileListView" VBox.vgrow="ALWAYS" />
                                
                                <HBox spacing="5" alignment="CENTER_LEFT">
                                    <Button text="Create" onAction="#handleCreateFile" />
                                    
                                    <Button text="Upload" onAction="#handleUpload" 
                                            style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
                                            
                                    <Button text="Edit" onAction="#handleEditFile" 
                                            style="-fx-background-color: #f39c12; -fx-text-fill: white;" />
                                            
                                    <Button text="Download" onAction="#handleDownloadFile" 
                                            style="-fx-background-color: #8e44ad; -fx-text-fill: white;" />
                                    
                                    <Region HBox.hgrow="ALWAYS" />
                                    
                                    <Button text="Share" onAction="#handleShareFile" 
                                            style="-fx-background-color: #2980b9; -fx-text-fill: white;" />
                                            
                                    <Button text="Delete" onAction="#handleDeleteFile" 
                                            style="-fx-background-color: #c0392b; -fx-text-fill: white;" />
                                </HBox>
                            </VBox>
                        </Tab>
                        
                        <Tab text="Users (Admin)">
                            <VBox spacing="10" style="-fx-padding: 10;">
                                <ListView fx:id="userListView" VBox.vgrow="ALWAYS" />
                                <Button text="Add New User" onAction="#handleCreateUser" maxWidth="Infinity" />
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>

                <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: #121212;">
                    <TextArea fx:id="terminalOutput" editable="false" VBox.vgrow="ALWAYS" 
                              style="-fx-control-inner-background: black; -fx-text-fill: #00FF00; -fx-font-family: 'Courier New';" />
                    
                    <TextField fx:id="commandInput" onAction="#handleCommand" promptText="Enter command..." 
                               style="-fx-background-color: #333; -fx-text-fill: #00FF00;"/>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>